{
  "name": "dsh-vm-shell",
  "version": "1.0.0",
  "description": "Elevated PowerShell inside a Hyper-V guest from DeepSeek Harness, without fighting UAC: hypervisor-level input injection plus PowerShell Direct over VMBus.",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "win32"
  ],
  "scripts": {
    "check": "node --check index.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "hyper-v",
    "powershell-direct",
    "vm",
    "uac"
  ],
  "license": "MIT"
}
